# Flask
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-string

# Database (SQLite by default; PostgreSQL example below)
DATABASE_URL=sqlite:///instance/bloodlink.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bloodlink

# Business rules
DONATION_COOLDOWN_DAYS=90
PER_PAGE=20
REQUIRE_EMAIL_VERIFICATION=false

# Sessions
SESSION_COOKIE_SECURE=false

# Rate limiting
RATELIMIT_STORAGE_URI=memory://

# Optional SMTP (leave blank to log verification/reset links to the console)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@bloodlink.local
MAIL_SUPPRESS_SEND=true

ADMIN_EMAIL=admin@bloodlink.local
# Optional: create/promote this admin automatically on serverless hosts.
# ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_NAME=BloodLink Admin
